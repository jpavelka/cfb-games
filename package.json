{
	"name": "cfb-games",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config ./vite.config.ts --watch",
		"fetch:teams": "tsx scripts/fetch-teams.ts",
		"fetch:sagarin": "tsx scripts/fetch-sagarin-ratings.ts",
		"fetch:weeks": "tsx scripts/fetch-weeks.ts",
		"fetch:broadcasters": "tsx scripts/fetch-broadcasters.ts",
		"check:winsipedia-slugs": "tsx scripts/check-winsipedia-slugs.ts",
		"deploy:server": "bash scripts/deploy.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
