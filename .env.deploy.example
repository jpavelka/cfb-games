# Copy this file to .env.deploy and fill in real values, then run `scripts/deploy.sh`.

PROJECT_ID=your-gcp-project-id
REGION=your-gcp-region
BUCKET_NAME=your-globally-unique-bucket-name
SERVICE_NAME=cfb-scoreboard-refresh
QUEUE_NAME=cfb-scoreboard-refresh-queue
RUNTIME_SA=cfb-scoreboard-refresh-runtime
INVOKER_SA=cfb-scoreboard-refresh-invoker
ALLOWED_ORIGINS=https://origin-you-want-to-allow,http://localhost:5173

# collegefootballdata.com API key — used by the deployed service's daily
# /refresh-betting job to backfill betting lines/pregame win probability the
# ESPN scoreboard is missing. Get one at https://collegefootballdata.com/key.
CFBD_API_KEY=your-collegefootballdata-api-key
